# RAAH Backend Configuration

# Server
PORT=8000
HOST=0.0.0.0
DATABASE_URL=sqlite:///./raah.db

# Autonomous Agentic AI
GEMINI_API_KEY=your_gemini_api_key_here

# Payment Integration (Optional for live Razorpay Test sandbox)
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret

# Demo & Engine Settings
DEMO_MODE=true
RETRYGUARD_WINDOW_MINUTES=15
RETRYGUARD_SIMILARITY_PERCENT=0.05
BACKGROUND_WORKER_INTERVAL_SECONDS=5
